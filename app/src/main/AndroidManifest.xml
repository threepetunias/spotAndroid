<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Permissions Spot declares, and why (nothing else is requested):
      - VIBRATE: the rest timer buzzes when time is up.
      - POST_NOTIFICATIONS: the "workout in progress" notice. Asked once, after the first logged set, and the app works without it.
      No network, storage, location, contacts, exact-alarm or full-screen permissions.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher_a"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Spot">

        <!-- The one screen. Not a launcher entry itself: the three icon choices below are. Opens only spot:// links, checked again in code. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="spot" />
            </intent-filter>
        </activity>

        <!-- App icon choices (Settings > App icon). Exactly one is turned on at a time. -->
        <activity-alias
            android:name=".IconA"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_a"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconB"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_b"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconC"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_c"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Home screen widgets. Android itself sends the update message, so these are exported (required) and ignore anything else. -->
        <receiver android:name=".TodayWidgetProvider" android:exported="true" android:label="Today">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_today_info" />
        </receiver>
        <receiver android:name=".WeekWidgetProvider" android:exported="true" android:label="This week">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_week_info" />
        </receiver>
        <receiver android:name=".RecordWidgetProvider" android:exported="true" android:label="Newest record">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_record_info" />
        </receiver>
        <receiver android:name=".FunWidgetProvider" android:exported="true" android:label="Fun total">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_fun_info" />
        </receiver>
        <receiver android:name=".ActionWidgetProvider" android:exported="true" android:label="Add workout">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_action_info" />
        </receiver>
    </application>

    <queries>
        <!-- Lets Spot ask whether Tend can be opened. Declares one app, not all apps. -->
        <package android:name="com.tendapp.personal" />
    </queries>
</manifest>
